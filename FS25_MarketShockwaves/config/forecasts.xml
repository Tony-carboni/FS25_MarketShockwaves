<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!--
    Forecasts (speculation). See scripts/model/Forecast.lua and DESIGN.md.

    A FORECAST is announced long before anything happens, with a stated
    confidence. Prices stay flat, then edge the forecast way just before the
    verdict (the pre-move), and the verdict starts an ordinary event.

    A forecast has a KIND, which decides how its dates are worked out:

      crop    timed by the map's own crop calendar, read at load. The message
              arrives in the two months before the anchor crop's sowing opens,
              the verdict falls when its harvest starts, and the effect lasts
              twelve months: until the harvest after that. `anchors` lists the
              crops to time it by, first one the map has wins.
      window  fixed calendar months: `arriveMonths`, each variant's
              `verdictMonth`, and `endMonth` for when the effect is over.
      fixed   any month; `leadMonths` to the verdict, `durationMonths` of
              effect.

    NO MONTHS ARE WRITTEN FOR CROP FORECASTS. Maps change the calendar, and a
    forecast that arrives after sowing has closed is worthless.

    Each <variant> names the event its verdict starts when the analysts were
    right (`event`) and the one it starts when the market goes the other way
    (`backfire`). `extraEvent` is a second, existing event started alongside
    when the forecast's own cause really happened.

    <premove> lists the products that edge the forecast way before the verdict.

    OUTCOME EVENTS use exactly the schema of config/events.xml, but live here:
    the random scheduler never rolls them, they have no season, and the tools
    that document the random events do not list them. Their length is set by
    the forecast (durationMonths below is only the fallback). Both sides of one
    forecast share a subtype, so they can never run together.
-->
<forecasts>
    <settings>
        <!-- Roll rate before the cooldown; with it, about one forecast a year.
             The player's "Forecasts per year" setting scales both: the rate up
             and the cooldown down by the same factor. Measured over 3,000
             simulated years: setting 0.5 gives 0.51, 1 gives 0.94, 1.5 gives
             1.42, 2 gives 1.75 (a forecast cannot open while its own event is
             still running, which holds the top end back). -->
        <forecastsPerYear value="4.0"/>
        <cooldownMonths value="9"/>
        <maxOpen value="2"/>
        <!-- THE ACTIONABILITY CHECK: fewer months than this between the message
             and the verdict, and the forecast is not offered on that map. -->
        <minLeadMonths value="4"/>
        <!-- The pre-move is this share of the expected (medium) move. -->
        <premoveShare value="0.25"/>
        <!-- How sure the experts are. Never below 70: a 60/40 is not worth
             speculating on. The number is the true chance they are right. -->
        <confidence c70="0.50" c80="0.35" c90="0.15"/>
        <!-- Shares among "the analysts were right" outcomes... -->
        <outcomes asForecast="40" stronger="12" milder="8" wrongReason="10"/>
        <!-- ...and how hard a backfire hits (severity of the mirror event). -->
        <backfire low="60" medium="40"/>
    </settings>

    <forecast id="millingGrains" kind="crop" anchors="WHEAT OAT" premoveMonths="1" weight="1.0">
        <premove>WHEAT OAT</premove>
        <variant id="up"   event="fcGrainsUp"   backfire="fcGrainsDown"/>
        <variant id="down" event="fcGrainsDown" backfire="fcGrainsUp"/>
    </forecast>

    <forecast id="vegetableOil" kind="crop" anchors="CANOLA SUNFLOWER" premoveMonths="1" weight="1.0">
        <premove>CANOLA SUNFLOWER</premove>
        <variant id="up"   event="fcOilUp"   backfire="fcOilDown"/>
        <variant id="down" event="fcOilDown" backfire="fcOilUp"/>
    </forecast>

    <forecast id="biofuel" kind="crop" anchors="MAIZE SOYBEAN" premoveMonths="1" weight="1.0">
        <premove>MAIZE SOYBEAN</premove>
        <variant id="up"   event="fcBiofuelUp"   backfire="fcBiofuelDown"/>
        <variant id="down" event="fcBiofuelDown" backfire="fcBiofuelUp"/>
    </forecast>

    <forecast id="foodProcessors" kind="crop" anchors="POTATO SUGARBEET SUGARCANE" premoveMonths="1" weight="1.0">
        <premove>POTATO SUGARBEET SUGARCANE</premove>
        <variant id="up"   event="fcProcessorsUp"   backfire="fcProcessorsDown"/>
        <variant id="down" event="fcProcessorsDown" backfire="fcProcessorsUp"/>
    </forecast>

    <!-- Not tied to a season. Two months of pre-move: a mill stocking its yard
         before opening, or running its stock down before closing. -->
    <forecast id="sawmill" kind="fixed" leadMonths="12" durationMonths="12" premoveMonths="2" weight="1.0">
        <premove>WOOD</premove>
        <variant id="open"  event="fcSawmillOpen"  backfire="fcSawmillOpenBackfire"/>
        <variant id="close" event="fcSawmillClose" backfire="fcSawmillCloseBackfire"/>
    </forecast>

    <!-- Arrives in late winter, so corn for silage is still a choice. The effect
         ends in April, when animals go back out to graze. A severe winter that
         really happens also starts the existing Harsh Winter event (energy). -->
    <forecast id="winterFeed" kind="window" arriveMonths="2 3 4" endMonth="4" weight="1.0">
        <premove>SILAGE DRYGRASS_WINDROW GRASS_WINDROW STRAW FORAGE</premove>
        <variant id="severe" event="fcFeedUp"   backfire="fcFeedDown" verdictMonth="11"
                 premoveMonths="2" extraEvent="harshWinter"/>
        <variant id="long"   event="fcFeedDown" backfire="fcFeedUp"   verdictMonth="10"
                 premoveMonths="1"/>
    </forecast>

